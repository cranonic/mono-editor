{
  "id": "language-support.typescript",
  "name": "TS/JS",
  "description": "Full TypeScript & JavaScript language features via built-in TypeScript Web Worker LSP (default) or external typescript-language-server in Alpine/native terminal — IntelliSense, inlay hints, refactoring, formatting, and project-wide navigation.",
  "version": "1.1.0",
  "category": "Language Support",
  "tags": ["typescript", "javascript", "ts", "js", "tsx", "jsx", "intellisense", "inlay-hints", "lsp", "web-worker"],
  "activates": ["typescript", "typescriptreact", "javascript", "javascriptreact", "json", "jsonc"],
  "icon": "image/icon.png",
  "iconColor": "#3178C6",
  "iconLetter": "TS",
  "main": "dist/main.js",
  "source": "main.js",
  "readme": "README.md",
  "changelog": "CHANGELOG.md",
  "license": "LICENSE.txt",
  "contributes": {
    "languages": [
      {
        "id": "typescript",
        "extensions": [".ts", ".mts", ".cts"],
        "aliases": ["TypeScript", "ts"]
      },
      {
        "id": "typescriptreact",
        "extensions": [".tsx", ".mtsx"],
        "aliases": ["TypeScript React", "tsx"]
      },
      {
        "id": "javascript",
        "extensions": [".js", ".mjs", ".cjs"],
        "aliases": ["JavaScript", "js"]
      },
      {
        "id": "javascriptreact",
        "extensions": [".jsx"],
        "aliases": ["JavaScript React", "jsx"]
      }
    ],
    "snippets": [
      { "language": "typescript", "path": "./snippets/typescript.json" },
      { "language": "typescriptreact", "path": "./snippets/typescript.json" },
      { "language": "javascript", "path": "./snippets/javascript.json" },
      { "language": "javascriptreact", "path": "./snippets/javascript.json" }
    ],
    "commands": [
      {
        "id": "typescript.restartTsServer",
        "title": "TypeScript: Restart TS Server",
        "icon": "refresh"
      },
      {
        "id": "typescript.selectServerMode",
        "title": "TypeScript: Toggle Language Server Mode (Web Worker / Terminal)"
      },
      {
        "id": "typescript.selectTypeScriptVersion",
        "title": "TypeScript: Select TypeScript Version"
      },
      {
        "id": "typescript.goToProjectConfig",
        "title": "TypeScript: Go to Project Configuration"
      },
      {
        "id": "typescript.openTsServerLog",
        "title": "TypeScript: Open TS Server Log"
      },
      {
        "id": "javascript.reloadProjects",
        "title": "JavaScript: Reload Projects"
      }
    ],
    "configuration": "settings.json"
  }
}
