{
  "Console Log": {
    "prefix": "log",
    "body": ["console.log($1);"],
    "description": "console.log"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "function ${1:name}($2) {",
      "\t$0",
      "}"
    ],
    "description": "Function"
  },
  "Arrow Function": {
    "prefix": "af",
    "body": ["const ${1:name} = ($2) => $0;"],
    "description": "Arrow function"
  },
  "Async Function": {
    "prefix": "afn",
    "body": [
      "async function ${1:name}($2) {",
      "\t$0",
      "}"
    ],
    "description": "Async function"
  },
  "Export Function": {
    "prefix": "expfn",
    "body": [
      "export function ${1:name}($2) {",
      "\t$0",
      "}"
    ],
    "description": "Export function"
  },
  "Require Module": {
    "prefix": "req",
    "body": ["const ${1:name} = require('$0');"],
    "description": "CommonJS require"
  },
  "Import Module": {
    "prefix": "imp",
    "body": ["import ${1:name} from '$0';"],
    "description": "ESM import"
  },
  "Try Catch": {
    "prefix": "try",
    "body": [
      "try {",
      "\t$1",
      "} catch (${2:error}) {",
      "\t$0",
      "}"
    ],
    "description": "try/catch"
  },
  "React FC (JSX)": {
    "prefix": "rfc",
    "body": [
      "export function ${1:Name}({ $2 }) {",
      "\treturn (",
      "\t\t<div>$0</div>",
      "\t);",
      "}"
    ],
    "description": "React function component"
  }
}
