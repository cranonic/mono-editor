{
  "name": "@mono/editor",
  "version": "0.1.0",
  "description": "Mono Editor — canvas-based code editor (Monaco-free). Usable as a standalone API module.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./preview": "./src/preview/index.ts",
    "./react": "./src/react/MonoEditor.tsx"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --port=3000 --host=0.0.0.0",
    "check:arch": "node scripts/check-architecture.mjs"
  },
  "files": ["src", "docs", "README.md"],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": ["editor", "code-editor", "canvas", "mono", "monaco-alternative"],
  "license": "UNLICENSED",
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@types/katex": "^0.16.8",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0"
  }
}
